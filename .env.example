# Copy to .env next to docker-compose.yml and fill in the required values

# The version of the Graphnous images: edge (the latest build of main) or a
# release, such as 0.1.0
GRAPHNOUS_VERSION=edge

# Required: the password of the PostgreSQL instance the compose file starts.
# The database and user default to graphnous.
POSTGRES_PASSWORD=
# POSTGRES_DB=graphnous
# POSTGRES_USER=graphnous

# Required: the password of the Neo4j instance the compose file starts, of at
# least 8 characters
NEO4J_PASSWORD=

# The ports on the host of the web app and the server
# GRAPHNOUS_WEB_PORT=3000
# GRAPHNOUS_SERVER_PORT=1337

# The Docker socket the server starts git and scanner containers through
# GRAPHNOUS_DOCKER_SOCKET=/var/run/docker.sock
# The group that owns the Docker socket; leave unset on Docker Desktop.
# On Linux: stat -c %g /var/run/docker.sock
# DOCKER_GID=

# Optional: the OpenAI API key of the assistant
# OPENAI_API_KEY=

# Optional: private repositories over SSH. The private key, in double quotes
# as it spans lines, and the host keys of the git servers in known_hosts
# format (ssh-keyscan github.com); only hosts listed there are fetched from
# GRAPHNOUS_GIT_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
# GRAPHNOUS_GIT_SSH_KNOWN_HOSTS="github.com ssh-ed25519 AAAA..."

# Optional: the GitHub App, which reports on pull requests what they affect;
# see GITHUB_APP.md in graphnous-app
# GRAPHNOUS_GITHUB_ENABLED=true
# To create it from Graphnous's settings: a key to encrypt its secrets with
# (openssl rand -base64 32), where GitHub reaches the server, and, for a
# server on this machine, the smee.io channel that forwards the webhooks
# GRAPHNOUS_SECRETS_KEY=
# GRAPHNOUS_GITHUB_SERVER_URL=http://localhost:1337
# GRAPHNOUS_GITHUB_WEBHOOK_URL=https://smee.io/...
# Or an App created by hand
# GRAPHNOUS_GITHUB_APP_ID=
# GRAPHNOUS_GITHUB_PRIVATE_KEY=
# GRAPHNOUS_GITHUB_WEBHOOK_SECRET=
